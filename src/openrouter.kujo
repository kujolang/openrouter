CHAT_BASE := "https://openrouter.ai/api/v1"

func get(value, key, fallback) {
    if type(value) == "dict" && has_key(value, key) { return value[key] }
    return fallback
}

func endpoint(value) {
    if type(value) != "string" { return "" }
    url := trim(value)
    if regex_match(url, "[\\x00-\\x20\\x7f@?#\\\\]") { return "" }
    if !regex_match(lower(url), "^https://(?:[a-z0-9][a-z0-9.-]*|\\[[0-9a-f:.]+\\])(?::[0-9]{1,5})?(?:/[a-z0-9._~/-]*)?$") { return "" }
    for part in split(url,"/") {
        if part == "." || part == ".." { return "" }
    }
    authority := split(url,"/")[2]
    port := regex_find_all(authority,":[0-9]{1,5}$")
    if len(port) > 0 {
        number := to_int(substring(port[0],1,len(port[0])))
        if number < 1 || number > 65535 { return "" }
    }
    return regex_replace(url, "/+$", "")
}

func redact(text, key) {
    if type(text) == "string" && key != "" { return replace(text, key, "[REDACTED]") }
    return text
}

func redact_value(value, key) {
    if key == "" { return value }
    if type(value) == "string" { return redact(value,key) }
    if type(value) != "dict" && type(value) != "array" { return value }
    encoded := to_json(value)
    key_literal := to_json(key)
    if contains(encoded,substring(key_literal,1,len(key_literal)-1)) == 0 { return value }
    // Inspect JSON text tokens so numbers and nested structure keep their types.
    pattern := "\"(?:[^\"\\\\]|\\\\.)*\""
    literals := regex_split(encoded,pattern)
    tokens := regex_find_all(encoded,pattern)
    output := range(0,2*len(tokens)+1)
    for index in range(0,len(tokens)) {
        output[2*index] = literals[index]
        output[2*index+1] = to_json(redact(parse_json(tokens[index]),key))
    }
    output[2*len(tokens)] = literals[len(tokens)]
    return parse_json(join(output,""))
}

func redact_wire(text, key) {
    if key == "" || type(text) != "string" { return text }
    if contains(text,key) == 0 && contains(text,"\\") == 0 { return text }
    // Parse JSON strings before redaction so escaped credential values cannot
    // surface when a consumer decodes the raw response.
    try {
        data := parse_json(text)
        safe_data := redact_value(data,key)
        if safe_data != data { return to_json(safe_data) }
    } except error { }
    encoded_key := to_json(key)
    escaped_key := substring(encoded_key,1,len(encoded_key)-1)
    return redact(redact(text,escaped_key),key)
}

func hosted(base) {
    if base == "" { return false }
    authority := lower(split(base,"/")[2])
    return authority == "openrouter.ai" || authority == "openrouter.ai:443"
}

func attribution(headers,referer,title) {
    for value in [referer,title] {
        if type(value) != "string" || regex_match(value,"[\\x00-\\x1f\\x7f]") { return null }
    }
    if referer != "" { headers["HTTP-Referer"] := referer }
    if title != "" { headers["X-Title"] := title }
    return headers
}

func create_client_impl(config) {
    base := endpoint(get(config,"base_url",CHAT_BASE))
    key := get(config,"api_key",null)
    if key == null && hosted(base) { key = env("OPENROUTER_API_KEY") }
    if type(key) != "string" { key = "" }
    problem := ""
    if base == "" { problem = "OpenRouter base URL must be HTTPS." }
    return {"base_url":base,"api_key":key,"timeout":get(config,"timeout",60.0),"transport":get(config,"transport",null),"validation_error":problem,"http_referer":get(config,"http_referer",""),"app_title":get(config,"app_title","")}
}

func request(client, path, method, payload, stream) {
    base := endpoint(get(client,"base_url",""))
    if base == "" { return Err("OpenRouter base URL must be HTTPS.") }
    key := get(client,"api_key","")
    if type(key) != "string" || (method == "POST" && key == "") || regex_match(key,"[\\x00-\\x20\\x7f]") {
        return Err("OpenRouter API key is required and must be a valid bearer value.")
    }
    timeout := get(client,"timeout",60.0)
    if (type(timeout) != "int" && type(timeout) != "float") || timeout <= 0 || timeout - timeout != 0 {
        return Err("OpenRouter timeout must be a positive finite number.")
    }
    if method == "POST" && type(payload) != "dict" { return Err("OpenRouter request must be an object.") }
    transport := get(client,"transport",null)
    if type(transport) != "function" { transport = http_request }
    headers := {}
    if key != "" { headers["Authorization"] := "Bearer "+key }
    if method == "POST" { headers["Content-Type"] := "application/json" }
    headers = attribution(headers,get(client,"http_referer",""),get(client,"app_title",""))
    if headers == null { return Err("OpenRouter attribution headers must be strings without control characters.") }
    if key != "" {
        for name in ["HTTP-Referer","X-Title"] {
            if len(key) > 3 && contains(get(headers,name,""),key) { return Err("OpenRouter credentials are only allowed in Authorization.") }
        }
    }
    if stream { headers["Accept"] := "text/event-stream" }
    options := {"method":method,"timeout":timeout,"redirects":"none","max_response_bytes":8388608,"_headers":headers}
    if type(payload) == "dict" { options["_body"] := to_json(payload) }
    if stream { options["stream"] := true }
    result := transport(base+path,options)
    match result {
        case Err(error): { return Err(redact(to_string(error),key)) }
        case Ok(response): {
            status := get(response,"_status",0)
            if type(status) != "int" || status < 100 || status > 599 { return Err("OpenRouter returned an invalid HTTP status.") }
            body := get(response,"_body","")
            if type(body) != "string" || byte_length(body) > 8388608 { return Err("OpenRouter returned an invalid or oversized HTTP body.") }
            safe_response := {}
            for name in keys(response) {
                safe_name := name
                if name != "_body" && name != "_status" && name != "_headers" { safe_name = redact(name,key) }
                if name == "_body" { safe_response[safe_name] := redact_wire(response[name],key) }
                else { safe_response[safe_name] := redact_value(response[name],key) }
            }
            return Ok(safe_response)
        }
        case other: { return Err("OpenRouter transport must return a Result.") }
    }
}


func choice_error(data) {
    choices := get(data,"choices",[])
    return type(choices) == "array" && len(choices) > 0 && get(choices[0],"finish_reason","") == "error"
}

func provider_error(data) {
    return get(data,"error",null) != null || choice_error(data)
}

func failure_message(data) {
    nested := get(data,"error",data)
    message := get(nested,"message",nested)
    if type(message) == "string" && message != "" { return message }
    return "OpenRouter request failed."
}

func stream_map(response,key) {
    status := response["_status"]
    parsed := parse_stream_impl(get(response,"_stream_chunks",[]),get(response,"_body",""))
    if !parsed["ok"] || !parsed["complete"] || len(parsed["events"]) == 0 {
        return {"ok":false,"status_code":status,"message":"OpenRouter returned a malformed or incomplete SSE stream."}
    }
    events := parsed["events"]
    text := range(0,len(events))
    tool_arguments := {}
    terminal := false
    for index in range(0,len(events)) {
        event := events[index]
        if provider_error(event) { return {"ok":false,"status_code":status,"message":redact(failure_message(event),key)} }
        text[index] = ""
        choices := get(event,"choices",[])
        if type(choices) != "array" { return {"ok":false,"status_code":status,"message":"OpenRouter stream choices must be an array."} }
        if len(choices) == 0 { continue }
        choice := choices[0]
        reason := get(choice,"finish_reason",null)
        if type(reason) == "string" && reason != "" { terminal = true }
        delta := get(choice,"delta",{})
        content := get(delta,"content",null)
        if type(content) == "string" { text[index] = content }
        calls := get(delta,"tool_calls",[])
        if key != "" && type(calls) == "array" {
            for call in calls {
                argument := get(get(call,"function",{}),"arguments",null)
                if type(argument) == "string" {
                    id := to_string(get(call,"index",0))
                    tool_arguments[id] := push(get(tool_arguments,id,[]),argument)
                }
            }
        }
    }
    if !terminal { return {"ok":false,"status_code":status,"message":"OpenRouter stream ended before a terminal choice."} }
    safe_events := redact_value(events,key)
    assembled := join(text,"")
    stitched := redact(assembled,key) != assembled
    for id in keys(tool_arguments) {
        arguments := join(tool_arguments[id],"")
        if redact(arguments,key) != arguments { stitched = true; break }
    }
    if stitched || safe_events != events {
        if has_key(response,"_stream_chunks") { response["_stream_chunks"] = [] }
        if has_key(response,"_body") { response["_body"] = "" }
    }
    if stitched { safe_events = [] }
    return {"ok":true,"status_code":status,"data":null,"events":safe_events,"response":response}
}

func response_map(result,key,stream) {
    match result {
        case Err(error): { return {"ok":false,"message":to_string(error)} }
        case Ok(response): {
            status := response["_status"]
            if stream && status >= 200 && status <= 299 { return stream_map(response,key) }
            body := get(response,"_body","")
            data := null
            try { data := parse_json(body) } except error { data := null }
            if status < 200 || status > 299 || provider_error(data) {
                return {"ok":false,"status_code":status,"message":failure_message(data),"error_body":body}
            }
            if type(data) != "dict" {
                return {"ok":false,"status_code":status,"message":"OpenRouter returned a malformed JSON response."}
            }
            return {"ok":true,"status_code":status,"data":data,"response":response}
        }
    }
}

func chat_impl(client,options) {
    streaming := get(options,"stream",false) == true
    return response_map(request(client,"/chat/completions","POST",options,streaming),get(client,"api_key",""),streaming)
}

func parse_stream_impl(chunks, body) {
    failed := {"ok":false,"events":[],"complete":false}
    combined := body
    if type(chunks) == "array" && len(chunks) > 0 {
        if len(chunks) > 65536 { return failed }
        size := 0
        for chunk in chunks {
            if type(chunk) != "string" { return failed }
            size = size + byte_length(chunk)
            if size > 8388608 { return failed }
        }
        combined = join(chunks,"")
    }
    if type(combined) != "string" || byte_length(combined) > 8388608 { return failed }
    if contains(combined,"\r") > 0 { combined = replace(replace(combined,"\r\n","\n"),"\r","\n") }
    blocks := split(combined,"\n\n")
    if len(blocks) > 65536 { return failed }
    events := range(0,len(blocks))
    count := 0
    complete := false
    for block in blocks {
        data := ""
        if starts_with(block,"data:") && contains(block,"\n") == 0 {
            data = trim(substring(block,5,len(block)))
        } else {
            lines := []
            for line in split(block,"\n") {
                if starts_with(line,"data:") { lines = push(lines,substring(line,5,len(line))) }
            }
            data = trim(join(lines,"\n"))
        }
        if data == "" { continue }
        if complete { return failed }
        if data == "[DONE]" { complete = true; continue }
        parsed := null
        try { parsed := parse_json(data) } except error { return failed }
        if type(parsed) != "dict" { return failed }
        events[count] = parsed
        count = count + 1
    }
    return {"ok":true,"events":slice(events,0,count),"complete":complete}
}

export create_client := create_client_impl
export chat := func(options) { return chat_impl(create_client_impl({}),options) }
export client_chat := chat_impl
export client_models := func(client) { return request(client,"/models","GET",null,false) }
export parse_stream := parse_stream_impl
export openrouter_endpoint := endpoint
export openrouter_base := CHAT_BASE
export openrouter_provider_error := provider_error
export openrouter_failure_message := failure_message
export openrouter_hosted := hosted
export openrouter_attribution := attribution
