test_setup { from src.provider import openrouter_provider, openrouter_driver }
test "compatible driver preserves routing" { p:=openrouter_provider({"model":"openai/test"}); d:=openrouter_driver(); e:=d["encode_chat"]({"provider":p,"credential":"secret","messages":[{"role":"user","content":"hi"}],"resolved_options":{"model":"openai/test","provider":{"zdr":true}}}); assert_equal(contains(e["url"],"chat/completions"),1); assert_equal(contains(e["body"],"zdr"),1) }
test "driver maps chat response and usage" { r:=openrouter_driver()["decode_chat"]({"fallback_model":"m","data":{"model":"m","choices":[{"message":{"content":"ok"},"finish_reason":"stop"}],"usage":{"prompt_tokens":4,"completion_tokens":2,"total_tokens":6}}}); assert_equal(r["output_text"],"ok"); assert_equal(r["usage"]["total_tokens"],6) }
